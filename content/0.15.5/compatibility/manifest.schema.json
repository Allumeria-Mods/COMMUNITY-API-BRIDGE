{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allumeria.community/schemas/compatibility-manifest-v2.json",
  "title": "Allumeria Community Compatibility Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "versionModel", "builds"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "versionModel": { "type": "string", "minLength": 1 },
    "builds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/build" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": { "type": "string", "format": "uuid" },
    "featureStatusMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "enum": ["PASS", "REVIEW", "FAIL", "DISABLED"] }
    },
    "semanticTargetStatusMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": {
        "enum": [
          "EXACT",
          "SIGNATURE_MATCH_IL_CHANGED",
          "RENAMED_CANDIDATE",
          "STRUCTURAL_MATCH",
          "MISSING",
          "AMBIGUOUS"
        ]
      }
    },
    "requiredLocalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "keyCount", "keySetSha256"],
      "properties": {
        "status": { "enum": ["VERIFIED", "REVIEW", "INCOMPLETE"] },
        "keyCount": { "type": "integer", "minimum": 1 },
        "keySetSha256": { "$ref": "#/$defs/sha256" },
        "hardcodedTextCensusStatus": { "enum": ["VERIFIED", "REVIEW", "INCOMPLETE"] },
        "hardcodedTextCensusSha256": { "$ref": "#/$defs/sha256" },
        "literalMediationMappingSha256": { "$ref": "#/$defs/sha256" },
        "hardcodedTextRequiredTargetCount": { "type": "integer", "minimum": 1 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productVersion",
        "assemblyVersion",
        "informationalVersion",
        "assemblyMvid",
        "assemblySha256",
        "apiSurfaceHash",
        "apiSurfaceHashAlgorithm"
      ],
      "properties": {
        "productVersion": { "type": "string", "minLength": 1 },
        "assemblyVersion": { "type": ["string", "null"] },
        "informationalVersion": { "type": ["string", "null"] },
        "assemblyMvid": { "$ref": "#/$defs/uuid" },
        "assemblySha256": { "$ref": "#/$defs/sha256" },
        "apiSurfaceHash": { "$ref": "#/$defs/sha256" },
        "apiSurfaceHashAlgorithm": { "const": "managed-public-surface-v1" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "identity", "adapterId", "status", "features", "semanticTargets"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "identity": { "$ref": "#/$defs/identity" },
        "adapterId": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["SUPPORTED_BASELINE", "RECOVERED_SUPPORTED", "CANDIDATE"]
        },
        "promotionVerdict": { "type": ["string", "null"] },
        "features": { "$ref": "#/$defs/featureStatusMap" },
        "semanticTargets": { "$ref": "#/$defs/semanticTargetStatusMap" },
        "requiredLocalization": { "$ref": "#/$defs/requiredLocalization" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "CANDIDATE" } } },
          "then": { "required": ["promotionVerdict"] }
        }
      ]
    }
  }
}
